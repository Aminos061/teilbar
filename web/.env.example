# Vorlage. Kopiere sie nach web/.env.local und trage die Werte ein. .env.local wird nie committiert.
# Nur Werte, die für den Browser bestimmt sind, dürfen mit NEXT_PUBLIC_ beginnen.
# Einen Secret Key oder service_role-Key gibt es hier nicht und gehört nie in den Browser-Code.

# Lokal: Die Werte zeigt `supabase status` nach `supabase start` (API-URL, Publishable Key).
# Cloud: Dashboard → Project Settings → API (Project URL, Publishable Key).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
