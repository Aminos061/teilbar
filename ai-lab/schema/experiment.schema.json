{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Aminos061/teilbar/ai-lab/schema/experiment.schema.json",
  "title": "Experiment (eine Zeile in daten/experimente.jsonl)",
  "description": "Ein geplanter Vergleich von Konfigurationen an derselben Aufgabe. Zahlen zum Befund rechnet lab.py bericht aus laeufe.jsonl.",
  "type": "object",
  "required": [
    "id",
    "hypothesis",
    "status",
    "owner",
    "rater",
    "variable",
    "configs",
    "runs_per_config",
    "base_commit",
    "task",
    "decision_rule",
    "created"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^E\\d+$",
      "description": "E + Nummer des GitHub-Issues"
    },
    "hypothesis": {
      "type": "string",
      "pattern": "^H\\d+$"
    },
    "status": {
      "enum": [
        "geplant",
        "laeuft",
        "bewertung",
        "abgeschlossen",
        "abgebrochen"
      ]
    },
    "owner": {
      "$ref": "defs.schema.json#/$defs/person"
    },
    "rater": {
      "$ref": "defs.schema.json#/$defs/person",
      "description": "bewertet blind, nicht owner"
    },
    "second_rater": {
      "oneOf": [
        {
          "$ref": "defs.schema.json#/$defs/person"
        },
        {
          "type": "null"
        }
      ]
    },
    "variable": {
      "type": "string"
    },
    "configs": {
      "type": "object",
      "minProperties": 2,
      "propertyNames": {
        "pattern": "^[A-Z]$"
      },
      "additionalProperties": {
        "$ref": "defs.schema.json#/$defs/config"
      }
    },
    "runs_per_config": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "base_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "task": {
      "type": "object",
      "required": [
        "title",
        "prompt",
        "checklist"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "prompt": {
          "type": "string",
          "description": "Auftrag, wortgleich für alle Läufe"
        },
        "checklist": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "time_limit_min": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "decision_rule": {
      "type": "string"
    },
    "noise_probe": {
      "type": [
        "string",
        "null"
      ],
      "description": "A/A-Probe: Verweis oder Ergebnis"
    },
    "created": {
      "type": "string",
      "format": "date"
    },
    "finding": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "date",
        "decision",
        "summary"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "decision": {
          "enum": [
            "gestuetzt",
            "nicht-gestuetzt",
            "unklar"
          ]
        },
        "summary": {
          "type": "string"
        },
        "limits": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
