{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Aminos061/teilbar/ai-lab/schema/sitzung.schema.json",
  "title": "Sitzung (eine Zeile in daten/sitzungen/<person>.jsonl)",
  "description": "Eine Sitzung mit einem Agenten. Kandidaten aus der Sitzung stehen in kandidaten.jsonl mit origin = id.",
  "type": "object",
  "required": [
    "id",
    "date",
    "person",
    "task",
    "phases",
    "config",
    "work_mode",
    "outcome",
    "first_try",
    "tokens",
    "minutes",
    "goal",
    "prompts",
    "result"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}_[a-z]+_[a-z0-9-]+_[a-z0-9-]+$",
      "description": "JJJJ-MM-TT_<person>_<harness>_<issue>-<kurzname>"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "person": {
      "$ref": "defs.schema.json#/$defs/person"
    },
    "task": {
      "type": "object",
      "required": [
        "issue",
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "issue": {
          "type": [
            "integer",
            "null"
          ],
          "description": "GitHub-Issue; null nur bei Organisation ohne Issue"
        },
        "title": {
          "type": "string",
          "minLength": 3
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "pr": {
          "type": [
            "integer",
            "null"
          ]
        },
        "commits": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{7,40}$"
          }
        }
      }
    },
    "phases": {
      "$ref": "defs.schema.json#/$defs/phases"
    },
    "config": {
      "$ref": "defs.schema.json#/$defs/config"
    },
    "work_mode": {
      "enum": [
        "autonom",
        "iterativ",
        "gemischt"
      ],
      "description": "autonom: Ziel vorgegeben; iterativ: gemeinsam geplant, kleine Schritte"
    },
    "outcome": {
      "enum": [
        "erfolgreich",
        "teilweise",
        "gescheitert",
        "abgebrochen"
      ]
    },
    "first_try": {
      "enum": [
        "ja",
        "nachgebessert",
        "verworfen"
      ]
    },
    "self_rating": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 5
    },
    "minutes": {
      "$ref": "defs.schema.json#/$defs/minutes"
    },
    "tokens": {
      "$ref": "defs.schema.json#/$defs/tokens"
    },
    "shadow_price_usd": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "setzt lab.py add aus tokens und preise.yaml"
    },
    "goal": {
      "type": "string",
      "minLength": 20,
      "description": "Ziel und Kontext, 2–4 Sätze"
    },
    "prompts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "description": "Die 1–3 entscheidenden Prompts wörtlich; sonst mit „sinngemäß:“ davor"
    },
    "agent_plan": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Schrittliste des Agenten, Abweichungen markiert"
    },
    "result": {
      "type": "string",
      "description": "Was herauskam, was nachgebessert oder verworfen wurde"
    },
    "went_well": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "mit Beleg"
    },
    "went_badly": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "mit Beleg; „hat nicht funktioniert“ ist ein Ergebnis"
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^H\\d+$"
      }
    },
    "experiment": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^E\\d+$"
        },
        "run": {
          "type": "string",
          "pattern": "^[A-Z][0-9]$"
        }
      }
    },
    "redacted": {
      "type": "boolean"
    }
  }
}
